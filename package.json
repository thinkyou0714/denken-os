{
  "name": "denken-os",
  "version": "0.1.0",
  "private": true,
  "description": "電験二種 学習OS — 問題生成＆検証エンジンと運用ロジックの実装",
  "type": "module",
  "license": "MIT",
  "author": "thinkyou0714",
  "homepage": "https://thinkyou0714.github.io/denken-os/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkyou0714/denken-os.git"
  },
  "bugs": {
    "url": "https://github.com/thinkyou0714/denken-os/issues"
  },
  "keywords": [
    "denken",
    "電験",
    "電気主任技術者",
    "spaced-repetition",
    "fsrs",
    "study",
    "問題生成"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node --import tsx lib/engine/cli.ts",
    "export:vault": "node --import tsx scripts/export-vault.ts",
    "export:video-scripts": "node --import tsx scripts/export-video-scripts.ts",
    "build:problems": "node --import tsx scripts/build-problems.ts",
    "seed:data": "node --import tsx scripts/seed-data-problems.ts",
    "build:web": "node --import tsx scripts/build-web.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "validate:data": "node --import tsx scripts/validate-problems.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/infra/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:web && npm run typecheck:service && npm run validate:data && npm run build:service-data && npm test && npm run build:web",
    "audit:status": "node --import tsx scripts/audit-status.ts",
    "audit:status:strict": "node --import tsx scripts/audit-status.ts --strict",
    "supervision:status": "node --import tsx scripts/supervision-status.ts",
    "supervision:packet": "node --import tsx scripts/supervision-packet.ts",
    "supervision:mark": "node --import tsx scripts/supervision-mark.ts",
    "supervision:templates": "node --import tsx scripts/supervision-templates.ts status",
    "supervision:templates:packet": "node --import tsx scripts/supervision-templates.ts packet",
    "supervision:templates:mark": "node --import tsx scripts/supervision-templates.ts mark",
    "license:keygen": "node --import tsx scripts/license-keygen.ts",
    "license:issue": "node --import tsx scripts/license-issue.ts",
    "coverage:pastexam": "node --import tsx scripts/pastexam-coverage.ts",
    "release:check": "npm run release:semver && npm run verify && npm run audit:status:strict",
    "release:semver": "node -e \"const v=require('./package.json').version; const [ma,mi,pa]=v.split('.').map(Number); if([ma,mi,pa].some(isNaN)) { console.error('バージョン形式エラー: '+v); process.exit(1); } console.log('バージョン OK: '+v+' (major='+ma+', minor='+mi+', patch='+pa+')');\"",
    "build": "node --import tsx scripts/build-site.ts",
    "build:service-data": "node --import tsx scripts/build-service-data.ts",
    "typecheck:service": "tsc -p site/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@supabase/supabase-js": "^2.106.2",
    "drizzle-orm": "^0.45.2",
    "ts-fsrs": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  }
}
